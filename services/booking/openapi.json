      "MyBookingOut": {
        "description": "A booking with the slot it is for: what a person needs to see on one page.\n\nWithout the slot fields every list would cost one more request per row,\nand the interface would have to read a slot that is not its business.",
        "properties": {
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "ends_at": {
            "format": "date-time",
            "title": "Ends At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "master_id": {
            "title": "Master Id",
            "type": "string"
          },
          "price_minor": {
            "title": "Price Minor",
            "type": "integer"
          },
          "slot_id": {
            "format": "uuid",
            "title": "Slot Id",
            "type": "string"
          },
          "starts_at": {
            "format": "date-time",
            "title": "Starts At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slot_id",
          "client_id",
          "master_id",
          "status",
          "starts_at",
          "ends_at",
          "price_minor",
          "created_at",
          "updated_at"
        ],
        "title": "MyBookingOut",
        "type": "object"
      },
      "PaymentOut": {
        "properties": {
          "checkout_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkout Url"
          },
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "payment_id",
          "status",
          "checkout_url"
