{
  "components": {
    "schemas": {
      "BookingCreate": {
        "description": "The client is taken from the token, for the same reason as the master.",
        "properties": {
          "slot_id": {
            "format": "uuid",
            "title": "Slot Id",
            "type": "string"
          }
        },
        "required": [
          "slot_id"
        ],
        "title": "BookingCreate",
        "type": "object"
      },
      "BookingOut": {
        "properties": {
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "slot_id": {
            "format": "uuid",
            "title": "Slot Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slot_id",
          "client_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "BookingOut",
        "type": "object"
      },
      "BookingStatus": {
        "enum": [
          "pending",
          "confirmed",
          "cancelled",
          "expired"
        ],
        "title": "BookingStatus",
        "type": "string"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error",
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
