        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "ends_at": {
            "format": "date-time",
            "title": "Ends At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "master_id": {
            "title": "Master Id",
            "type": "string"
          },
          "price_minor": {
            "title": "Price Minor",
            "type": "integer"
          },
          "starts_at": {
            "format": "date-time",
            "title": "Starts At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "master_id",
          "starts_at",
          "ends_at",
          "price_minor",
          "available"
        ],
        "title": "SlotOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Token issued by the web service",
        "scheme": "bearer",
