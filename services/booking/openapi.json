      "SlotCreate": {
        "description": "Who the master is comes from the token, not from the body: a caller\nmust not be able to publish slots in someone else's name.",
        "properties": {
          "ends_at": {
            "format": "date-time",
            "title": "Ends At",
            "type": "string"
          },
          "price_minor": {
            "description": "Price in kopecks",
            "exclusiveMinimum": 0.0,
            "maximum": 1000000000.0,
            "title": "Price Minor",
            "type": "integer"
          },
          "starts_at": {
            "format": "date-time",
            "title": "Starts At",
            "type": "string"
          }
        },
        "required": [
          "starts_at",
          "ends_at",
          "price_minor"
        ],
        "title": "SlotCreate",
        "type": "object"
      },
