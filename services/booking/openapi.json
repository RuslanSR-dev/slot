        "parameters": [
          {
            "in": "query",
            "name": "master_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@-]+$",
              "title": "Master Id",
              "type": "string"
            }
          },
          {
            "description": "UTC day",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
